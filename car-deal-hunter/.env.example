# Local LLM (default). Install Ollama and run: ollama pull llama3.2
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2

# Optional free-tier APIs (leave unused if you have none)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# After Colab QLoRA, point at a local adapter folder or a public HF repo you own
# SPECIALIST_ADAPTER=data/qlora_adapter

DEAL_THRESHOLD=1500
